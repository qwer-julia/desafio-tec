<% content_for :title, "Você foi convidado(a)" %>
<% content_for :preheader, "#{@invitation.invited_by.name} te convidou para participar da Rataria." %>

<h1 style="margin:0 0 18px; display:inline-block; font-family:'Kalam','Trebuchet MS',cursive; font-weight:700; font-size:22px; color:#1a1a1a;">
  Você foi convidado(a)!
</h1>

<p style="margin:0 0 20px;"><%= @invitation.invited_by.name %> te convidou para participar da Rataria. Crie sua conta para começar a resolver os desafios.</p>

<%= render "mailer/button", url: signup_url(@token), label: "Aceitar convite", color: "#262626" %>

<p style="margin:0; font-size:13px; color:rgba(26,26,26,0.7);">
  Esse link expira em 7 dias. Se você não esperava este convite, pode ignorar este e-mail.
</p>
