<div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 mb-8">
  <%= avatar @user, class: "w-40 sm:w-48" %>
  <div class="text-center sm:text-left">
    <h1 class="font-display text-3xl sm:text-4xl text-3d mb-3"><%= @user.name.upcase %></h1>
    <p class="badge-mono inline-block mb-2"><%= @submissions_by_challenge_id.size %> <%= @submissions_by_challenge_id.size == 1 ? "desafio resolvido" : "desafios resolvidos" %></p><br>
    <p class="badge-mono inline-block mb-4"><%= @user.points %> pontos até agora</p>
    <% if @user == Current.user %>
      <div><%= link_to "Editar avatar", edit_avatar_path, class: "btn-funky btn-funky--grape text-xs! py-1.5! px-3!" %></div>
    <% end %>
  </div>
</div>
<p class="mb-8"><%= link_to "← Voltar ao placar", scoreboard_path, class: "link-squiggle font-bold" %></p>

<h2 class="font-display text-xl mb-4" style="color: var(--color-grape);">CALENDÁRIO</h2>

<% if @challenges.empty? %>
  <p class="text-ink/60">Ainda não teve nenhum desafio.</p>
<% else %>
  <ul class="grid sm:grid-cols-2 gap-3">
    <% @challenges.each do |challenge| %>
      <% submission = @submissions_by_challenge_id[challenge.id] %>
      <li class="card-groovy px-5 py-4 flex justify-between items-center gap-3" style="<%= "background: color-mix(in srgb, var(--color-teal) 30%, transparent);" if submission %>">
        <span>
          <%= link_to challenge.title, challenge_path(challenge), class: "font-bold link-squiggle" %>
          <% if challenge.interns_only? %><span class="badge-mono ml-2"><%= icon "star" %> parquinho</span><% end %>
        </span>
        <span class="flex items-center gap-3">
          <% if submission && !challenge.open? %>
            <%= link_to "Baixar", scoreboard_download_path(@user, challenge), class: "badge-mono", title: "Baixar entrega" %>
          <% end %>
          <% if submission %>
            <span class="text-xl" style="color: var(--color-teal);"><%= icon "circle-check", title: "Resolvido" %></span>
          <% else %>
            <span class="text-xl opacity-30"><%= icon "square", title: "Não resolvido" %></span>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>
<% end %>
